<Button Id=.ID
        Class=.Class
        Variant="outline"
        AriaLabel=.Label
        AriaExpanded=.Expanded
        AriaControls=.Controls
        OnClick=.OnClick>
  <svg class="hamburger-open" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M2.5 4h11M2.5 8h11M2.5 12h11"/>
  </svg>
  <svg class="hamburger-close" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/>
  </svg>
</Button>

<style>
.hamburger-open {
  display: block;
}
.hamburger-close {
  display: none;
}
[aria-expanded="true"] .hamburger-open {
  display: none !important;
}
[aria-expanded="true"] .hamburger-close {
  display: block !important;
}
</style>
